{
    "dependencies": [
        "boost-algorithm",
        "boost-filesystem",
        "boost-locale",
        "boost-iostreams",
        "boost-regex",
        "boost-property-tree",
        "fmt",
        "spdlog",
        "libjpeg-turbo",
        { "name": "libarchive", "version>=": "3.8.7" },
        "protobuf",
        "libjxl",
        {
            "name": "ffmpeg",
            "platform": "android",
            "default-features": false,
            "features": ["opus"]
        },
        {
            "name": "ffmpeg",
            "platform": "(linux | windows) & (x86 | x64)",
            "default-features": false,
            "features": ["nvcodec", "qsv"]
        },
        {
            "name": "ffmpeg",
            "platform": "linux",
            "default-features": false,
            "features": ["vaapi", "vulkan"]
        },
        {
            "name": "ffmpeg",
            "platform": "windows",
            "default-features": false,
            "features": ["vulkan"]
        },
        {
            "name": "libplacebo",
            "platform": "android | linux | osx | windows"
        },
        {
            "name": "ffmpeg",
            "version>=": "9.0.1",
            "default-features": false,
            "features": ["avcodec", "avfilter", "avformat", "dav1d", "swresample", "swscale"]
        }
    ],
    "overrides": [
        {
            "name": "vulkan-headers",
            "version": "1.4.357.0"
        },
        {
            "name": "vulkan-loader",
            "version": "1.4.357.0"
        },
        {
            "name": "ffmpeg",
            "version": "9.0.1"
        }
    ]
}
